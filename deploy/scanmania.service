[Unit]
# The game service: FSM, relay I/O, inputs, web server, local snapshots.
# Kept in git so a rebuild from a clean clone reproduces the running system.
# Before this file existed the units lived only on the NUC, and Restart=always
# was documented in prose that nothing enforced.
Description=ScanMania game service
Documentation=file:///opt/scanmania/docs/architecture.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

# Never give up restarting — an attraction must keep trying.
# These are [Unit] settings. They sat in [Service] where systemd silently
# ignores the ...Sec spelling, leaving the defaults (5 starts / 10 s) in force:
# any fast-exit failure put the unit in `failed` permanently.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
WorkingDirectory=/opt/scanmania
# Optional, like the kiosk unit. Without the dash a missing file makes the
# unit fail to LOAD, and with Restart=always + StartLimitBurst=0 it retries
# every couple of seconds forever while the panels show connection-refused.
EnvironmentFile=-/etc/default/scanmania

# Real vision. vision/service.py owns the RTSP pipeline; --fake-vision here was
# left over from before that class existed and silently disabled every camera.
# --config-dir is explicit so the box can never silently run on a different
# config directory than the one deploy.sh manages.
ExecStart=/opt/scanmania/.venv/bin/python -m scanmania --config-dir /opt/scanmania/config

# runner.py now re-raises when a subsystem task dies, so the process exits and
# systemd restarts it. It used to stay alive with a dead game loop, which meant
# this policy never fired. Invariant 7 makes the restart safe: the runner never
# resumes a run, it always comes back clean.
Restart=always
RestartSec=2

KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=scanmania

[Install]
WantedBy=multi-user.target
